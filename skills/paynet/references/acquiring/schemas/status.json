  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "status",
  "endpoint": "GET <BASE_URL>/api/v1/payment-service/payment/status?value=<transactionId|paymentId> (path form unconfirmed, see README)",
  "params": {
    "type": "object",
