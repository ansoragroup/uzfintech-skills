                  "CREATED",
                  "PENDING_CONFIRM",
                  "UNKNOWN",
                  "SUCCESS",
                  "FAILED",
                  "CANCELLED",
                  "RETURNED",
                  "CANCEL_PENDING",
                  "RETURN_PENDING"
                ]
              },
              "transactionId": {
                "type": "string"
              },
              "orderId": {
                "type": "string"
              },
              "paymentId": {
                "type": "string"
              },
              "attributes": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "HUMO",
              "UZCARD",
              null
            ]
          },
          "providerCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "providerMessage": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "details": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "code"
        ]
      }
    },
    "required": [
      "status"
    ]
  }
