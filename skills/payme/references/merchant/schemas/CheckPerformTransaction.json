{
  "x-uzfintech-source": {
    "source_url": "https://developer.help.paycom.uz/metody-merchant-api/checktransaction/",
    "fetched": "2026-11-03",
    "note": "hand-trimmed from the HTML reference; request body and result only"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "CheckPerformTransaction",
  "endpoint": "POST <your Endpoint URL> (Payme calls you; JSON-RPC 2.0)",
  "params": {
    "type": "object",
    "properties": {
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)",
        "minimum": 1
      },
      "account": {
        "type": "object",
        "description": "merchant-defined fields configured in the cashbox, e.g. order_id"
      }
    },
    "required": [
      "amount",
      "account"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "allow": {
        "type": "boolean",
        "description": "true when the payment may proceed",
        "const": true
      },
      "additional": {
        "type": "object",
        "description": "optional extra data shown to the payer; tell Payme staff before using it"
      },
      "detail": {
        "type": "object",
        "properties": {
          "receipt_type": {
            "type": "integer",
            "description": "fiscal receipt type: 0 = sale/return",
            "enum": [
              0
            ]
          },
          "shipping": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "price": {
                "type": "integer",
                "description": "tiyin",
                "minimum": 0
              }
            },
            "required": [
              "title",
              "price"
            ]
          },
          "items": {
            "type": "array",
            "description": "product lines; needed for fiscalization",
            "items": {
              "type": "object",
              "properties": {
                "discount": {
                  "type": "integer",
                  "description": "discount for the whole line (all units), tiyin",
                  "minimum": 0
                },
                "title": {
                  "type": "string",
                  "description": "product or service name"
                },
                "price": {
                  "type": "integer",
                  "description": "unit price, tiyin",
                  "minimum": 0
                },
                "count": {
                  "type": "number",
                  "description": "quantity"
                },
                "code": {
                  "type": "string",
                  "description": "IKPU (ИКПУ) product/service code from tasnif.soliq.uz"
                },
                "units": {
                  "type": "integer",
                  "description": "unit-of-measure code"
                },
                "package_code": {
                  "type": "string",
                  "description": "package code shown for the IKPU on tasnif.soliq.uz"
                },
                "vat_percent": {
                  "type": "number",
                  "description": "VAT percent for the line"
                }
              },
              "required": [
                "title",
                "price",
                "count",
                "code",
                "package_code",
                "vat_percent"
              ]
            }
          }
        },
        "required": [
          "receipt_type",
          "items"
        ]
      }
    },
    "required": [
      "allow"
    ]
  }
}
