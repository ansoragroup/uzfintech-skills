{
  "x-uzfintech-source": {
    "source_url": "https://developer.help.paycom.uz/metody-merchant-api/checktransaction/",
    "fetched": "2026-11-03",
    "note": "hand-trimmed from the HTML reference; request body and result only"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "object": "detail",
  "used_in": [
    "CheckPerformTransaction result.detail",
    "receipts.create params.detail",
    "checkout POST field detail (base64 JSON)"
  ],
  "schema": {
    "type": "object",
    "properties": {
      "receipt_type": {
        "type": "integer",
        "description": "fiscal receipt type: 0 = sale/return",
        "enum": [
          0
        ]
      },
      "shipping": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "description": "tiyin",
            "minimum": 0
          }
        },
        "required": [
          "title",
          "price"
        ]
      },
      "items": {
        "type": "array",
        "description": "product lines; needed for fiscalization",
        "items": {
          "type": "object",
          "properties": {
            "discount": {
              "type": "integer",
              "description": "discount for the whole line (all units), tiyin",
              "minimum": 0
            },
            "title": {
              "type": "string",
              "description": "product or service name"
            },
            "price": {
              "type": "integer",
              "description": "unit price, tiyin",
              "minimum": 0
            },
            "count": {
              "type": "number",
              "description": "quantity"
            },
            "code": {
              "type": "string",
              "description": "IKPU (ИКПУ) product/service code from tasnif.soliq.uz"
            },
            "units": {
              "type": "integer",
              "description": "unit-of-measure code"
            },
            "package_code": {
              "type": "string",
              "description": "package code shown for the IKPU on tasnif.soliq.uz"
            },
            "vat_percent": {
              "type": "number",
              "description": "VAT percent for the line"
            }
          },
          "required": [
            "title",
            "price",
            "count",
            "code",
            "package_code",
            "vat_percent"
          ]
        }
      }
    },
    "required": [
      "receipt_type",
      "items"
    ]
  }
}
