        "type": "string",
        "description": "MMYY in the sample"
      },
      "card_name": {
        "type": "string",
        "description": "holder name"
      },
      "cvc2": {
        "type": "string"
      },
      "client_ip_addr": {
        "type": "string",
        "description": "payer IP address"
      },
      "ext_id": {
        "type": "string",
        "description": "your external card id"
      }
    },
    "required": [
      "store_id",
      "pan",
      "expiry",
      "card_name",
      "cvc2",
      "client_ip_addr",
      "ext_id"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "status": {
        "$ref": "mps-status.json"
      },
      "payload": {
