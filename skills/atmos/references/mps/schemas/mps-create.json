{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#transaction-creation-ips",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "mps-create",
  "endpoint": "POST https://apigw.atmos.uz/mps/pay/transaction/create",
  "params": {
    "type": "object",
    "properties": {
      "transaction_id": {
        "type": "integer",
        "description": "draft id from pre-create"
      },
      "pan": {
        "type": "string",
        "description": "PCI DSS merchants only"
      },
      "expiry": {
        "type": "string"
      },
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)"
      },
      "card_name": {
        "type": "string"
      },
      "cvc2": {
        "type": "string"
      },
      "client_ip_addr": {
        "type": "string"
      },
      "ext_id": {
        "type": "string"
      }
    },
    "required": [
      "transaction_id",
      "pan",
      "expiry",
      "amount",
      "card_name",
      "cvc2",
      "client_ip_addr",
      "ext_id"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "status": {
        "$ref": "mps-status.json"
      },
      "payload": {
        "$ref": "mps-transaction.json"
      }
    },
    "required": [
      "status"
    ]
  },
  "x-auth": {
    "apikey": "<API_KEY>",
    "Authorization": "Bearer <ACCESS_TOKEN>"
  }
}
