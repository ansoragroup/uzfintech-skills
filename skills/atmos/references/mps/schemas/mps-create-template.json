{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#creating-a-recurring-payment-ips",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "mps-create-template",
  "endpoint": "POST https://apigw.atmos.uz/mps/pay/transaction/create/template",
  "params": {
    "type": "object",
    "properties": {
      "card_id": {
        "type": "integer",
        "description": "a 3DS-verified card"
      },
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)"
      },
      "client_ip_addr": {
        "type": "string"
      },
      "ext_id": {
        "type": "string"
      }
    },
    "required": [
      "card_id",
      "amount",
      "client_ip_addr",
      "ext_id"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "status": {
        "$ref": "mps-status.json"
      },
      "payload": {
        "$ref": "mps-transaction.json"
      }
    },
    "required": [
      "status"
    ]
  },
  "x-auth": {
    "apikey": "<API_KEY>",
    "Authorization": "Bearer <ACCESS_TOKEN>"
  },
  "x-note": "recurring charge without the payer; only for a card that passed 3DS"
}
