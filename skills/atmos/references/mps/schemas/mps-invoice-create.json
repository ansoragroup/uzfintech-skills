      },
      "expiration_date": {
        "type": "string",
        "description": "YYYY-MM-DDTHH:MM:SS"
      },
      "account": {
        "type": "string"
      },
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)"
      },
      "success_url": {
        "type": "string"
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "items_id": {
              "type": "string"
            },
            "code": {
              "type": "string",
              "description": "IKPU code; in the sample, not in the table"
            },
            "name": {
              "type": "string"
            },
            "amount": {
              "type": "integer",
              "description": "tiyin (1 UZS = 100 tiyin)"
            },
            "quantity": {
              "type": "integer"
            },
            "details": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
