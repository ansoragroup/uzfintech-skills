                  },
                  "values": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "values"
                ]
              }
            }
          },
          "required": [
            "items_id",
            "name",
            "amount",
            "details"
          ]
        },
        "minItems": 1
      }
    },
    "required": [
      "request_id",
      "store_id",
      "account",
      "amount",
      "success_url",
      "items"
    ]
  },
  "result": {
    "type": "object",
