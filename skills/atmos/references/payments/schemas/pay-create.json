{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#transaction-creating",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "pay-create",
  "endpoint": "POST https://apigw.atmos.uz/merchant/pay/create",
  "params": {
    "type": "object",
    "properties": {
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)",
        "minimum": 1
      },
      "account": {
        "type": [
          "integer",
          "string"
        ],
        "description": "your payment identifier (order id); used in reconciliation"
      },
      "terminal_id": {
        "type": "string",
        "description": "merchant terminal id"
      },
      "store_id": {
        "type": [
          "integer",
          "string"
        ],
        "description": "merchant store id issued by Atmos; samples send it as a number and as a string"
      },
      "lang": {
        "type": "string",
        "description": "answer language",
        "enum": [
          "uz",
          "ru",
          "en"
        ]
      },
      "ofd_items": {
        "type": "array",
        "items": {
          "$ref": "../../common/schemas/ofd-item.json"
        }
      }
    },
    "required": [
      "amount",
      "account",
      "store_id"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "result": {
        "$ref": "../../common/schemas/status.json"
      },
      "transaction_id": {
        "type": "integer",
        "description": "pass it to pay/pre-apply and pay/apply"
      },
      "store_transaction": {
        "$ref": "../../common/schemas/store-transaction.json"
      }
    },
    "required": [
      "result"
    ]
  }
}
