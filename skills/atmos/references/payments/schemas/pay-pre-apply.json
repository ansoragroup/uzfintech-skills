{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#transaction-pre-confirmation",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "pay-pre-apply",
  "endpoint": "POST https://apigw.atmos.uz/merchant/pay/pre-apply",
  "params": {
    "type": "object",
    "properties": {
      "card_token": {
        "type": "string",
        "description": "saved card token; no SMS is sent, apply with otp 111111"
      },
      "card_number": {
        "type": "string",
        "description": "16-digit PAN; an SMS code goes to the cardholder"
      },
      "expiry": {
        "type": "string",
        "description": "YYmm",
        "pattern": "^[0-9]{4}$"
      },
      "store_id": {
        "type": [
          "integer",
          "string"
        ],
        "description": "merchant store id issued by Atmos; samples send it as a number and as a string"
      },
      "transaction_id": {
        "type": "integer",
        "description": "transaction_id from pay/create"
      }
    },
    "required": [
      "store_id",
      "transaction_id"
    ],
    "oneOf": [
      {
        "required": [
          "card_token"
        ],
        "not": {
          "required": [
            "card_number"
          ]
        }
      },
      {
        "required": [
          "card_number",
          "expiry"
        ],
        "not": {
          "required": [
            "card_token"
          ]
        }
      }
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "transaction_id": {
        "type": "integer"
      },
      "result": {
        "$ref": "../../common/schemas/status.json"
      }
    },
    "required": [
      "result"
    ]
  },
  "x-note": "never send card_token together with card_number + expiry"
}
