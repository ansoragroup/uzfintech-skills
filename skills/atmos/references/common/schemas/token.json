{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#obtaining-a-token",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "token",
  "endpoint": "POST https://apigw.atmos.uz/token",
  "params": {
    "type": "object",
    "properties": {
      "grant_type": {
        "type": "string",
        "const": "client_credentials"
      },
      "refresh_token": {
        "type": "string",
        "description": "only to extend a token: the current access_token value"
      }
    },
    "required": [
      "grant_type"
    ],
    "x-in": "form"
  },
  "result": {
    "type": "object",
    "properties": {
      "access_token": {
        "type": "string"
      },
      "refresh_token": {
        "type": "string",
        "description": "only in the Visa/Mastercard sample"
      },
      "scope": {
        "type": "string",
        "description": "sample: am_application_scope default"
      },
      "token_type": {
        "type": "string",
        "description": "Bearer"
      },
      "expires_in": {
        "type": "integer",
        "description": "seconds; the text says 3600, samples show other values - trust this field"
      }
    },
    "required": [
      "access_token",
      "expires_in"
    ]
  },
  "x-auth": {
    "Authorization": "Basic base64(consumer_key:consumer_secret)",
    "Content-Type": "application/x-www-form-urlencoded"
  }
}
