{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#transaction-creation-pinfl",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "pinfl-create",
  "endpoint": "POST https://apigw.atmos.uz/ppa/transaction/create",
  "params": {
    "type": "object",
    "properties": {
      "ext_id": {
        "type": "string",
        "description": "your unique transaction id; never reuse (-302)"
      },
      "first_name": {
        "type": "string"
      },
      "last_name": {
        "type": "string"
      },
      "middle_name": {
        "type": "string"
      },
      "pinfl": {
        "type": "string",
        "description": "personal identification number (14 digits; the sample shows 18)"
      },
      "passport_series": {
        "type": "string"
      },
      "passport_number": {
        "type": "string"
      },
      "contract_number": {
        "type": "string"
      },
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)",
        "minimum": 1
      },
      "partial_debit": {
        "type": "boolean",
        "description": "default false; true lets Atmos take less than amount"
      },
      "ofd_items": {
        "type": "object",
        "properties": {
          "ofd_code": {
            "type": "string"
          },
          "package_code": {
            "type": "string"
          },
          "tin": {
            "type": "string"
          }
        },
        "required": [
          "ofd_code",
          "package_code",
          "tin"
        ],
        "description": "if sent, every field is required"
      },
      "epos": {
        "type": "object",
        "properties": {
          "branch_id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "terminal_group_id": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "branch_id",
          "terminal_group_id"
        ],
        "description": "if sent, every field is required"
      }
    },
    "required": [
      "ext_id",
      "first_name",
      "last_name",
      "middle_name",
      "pinfl",
      "passport_series",
      "passport_number",
      "contract_number",
      "amount"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "code": {
        "type": [
          "integer",
          "string"
        ],
        "description": "\"200\" on success (a string in most samples, a number in cards/check)"
      },
      "description": {
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "type": [
          "string",
          "null"
        ]
      },
      "payload": {
        "type": "object",
        "properties": {
          "available_balance": {
            "type": "integer"
          },
          "transaction_status": {
            "type": "string",
            "description": "CREATED"
          },
          "transaction_id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "ext_id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "amount": {
            "type": [
              "integer",
              "string"
            ]
          },
          "first_name": {
            "type": "string"
          },
          "middle_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "date_created": {
            "type": "string",
            "description": "YYYY-MM-DD HH:MM:SS"
          }
        }
      }
    },
    "required": [
      "code"
    ]
  },
  "x-note": "creates only; money moves on /ppa/transaction/confirm. Errors use negative codes, see pinfl/README.md"
}
