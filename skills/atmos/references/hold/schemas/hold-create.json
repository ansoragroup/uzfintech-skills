{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#create-a-hold-request",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "hold-create",
  "endpoint": "POST https://apigw.atmos.uz/hold/create",
  "params": {
    "type": "object",
    "properties": {
      "card_token": {
        "type": "string"
      },
      "card_number": {
        "type": "string",
        "description": "16-digit PAN"
      },
      "card_expiry": {
        "type": "string",
        "description": "YYmm"
      },
      "store_id": {
        "type": [
          "integer",
          "string"
        ],
        "description": "merchant store id issued by Atmos; samples send it as a number and as a string"
      },
      "account": {
        "type": [
          "integer",
          "string"
        ],
        "description": "your payment identifier"
      },
      "payment_details": {
        "type": "string"
      },
      "amount": {
        "type": [
          "integer",
          "string"
        ],
        "description": "tiyin (1 UZS = 100 tiyin); the sample sends a string"
      },
      "duration": {
        "type": [
          "integer",
          "string"
        ],
        "description": "hold lifetime in MINUTES; the sample sends a string"
      }
    },
    "required": [
      "store_id",
      "account",
      "amount",
      "duration"
    ],
    "oneOf": [
      {
        "required": [
          "card_token"
        ],
        "not": {
          "required": [
            "card_number"
          ]
        }
      },
      {
        "required": [
          "card_number",
          "card_expiry"
        ],
        "not": {
          "required": [
            "card_token"
          ]
        }
      }
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "result": {
        "$ref": "../../common/schemas/status.json"
      },
      "hold_id": {
        "type": "integer",
        "description": "pass it to PUT /hold/apply/{id}"
      },
      "account": {
        "type": [
          "integer",
          "string",
          "null"
        ]
      }
    },
    "required": [
      "result"
    ]
  }
}
