{
  "x-uzfintech-source": {
    "source_url": "https://docs.atmos.uz/en/#request-to-link-a-card",
    "fetched": "2026-11-04",
    "note": "hand-written from the docs.atmos.uz English page; trimmed to the documented fields; params = request body, result = whole answer body"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "method": "bind-card-init",
  "endpoint": "POST https://apigw.atmos.uz/partner/bind-card/init",
  "params": {
    "type": "object",
    "properties": {
      "card_number": {
        "type": "string",
        "description": "16-digit PAN"
      },
      "expiry": {
        "type": "string",
        "description": "YYmm",
        "pattern": "^[0-9]{4}$"
      }
    },
    "required": [
      "card_number",
      "expiry"
    ]
  },
  "result": {
    "type": "object",
    "properties": {
      "result": {
        "$ref": "../../common/schemas/status.json"
      },
      "transaction_id": {
        "type": "integer",
        "description": "pass it to bind-card/confirm"
      },
      "phone": {
        "type": "string",
        "description": "masked phone the SMS went to"
      }
    },
    "required": [
      "result"
    ]
  }
}
