  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "title": "QR Payment Request",
      "required": [
        "payment_id",
        "operation_id",
        "paid_sum",
        "date_time",
        "commission_info",
        "phone_number",
        "receipt_info"
