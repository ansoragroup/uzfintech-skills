      "type": "object",
      "properties": {
        "payment_id": {
          "title": "QR Payment Id",
          "type": "string",
          "maxLength": 36
        },
        "operation_id": {
          "title": "QR Operation Id",
          "type": "string",
          "format": "uuid"
        },
        "paid_sum": {
          "title": "Paid Sum",
          "type": "integer",
          "min": 1
        },
        "date_time": {
          "title": "Date Time",
          "type": "string",
          "format": "date-time"
        },
        "commission_info": {
          "title": "Commission Info",
          "allOf": [
            {
              "title": "ReceiptDataCommissionInfo",
              "type": "object",
              "properties": {
                "TIN": {
                  "title": "Tin",
                  "type": "string"
                },
                "PINFL": {
                  "title": "Pinfl",
                  "maxLength": 14,
                  "minLength": 14,
                  "type": "string"
                }
              }
            }
          ]
        },
        "phone_number": {
          "title": "Phone Number",
          "type": "string",
          "maxLength": 12
        },
        "sale_point_address": {
          "title": "Sale Point Address",
          "type": "string",
          "maxLength": 128
        },
        "receipt_info": {
          "title": "Receipt Info",
          "type": "object",
          "required": [
            "terminal_id",
            "receipt_seq"
          ],
          "properties": {
            "terminal_id": {
              "type": "string",
              "maxLength": 14
            },
            "receipt_seq": {
              "type": "string",
              "maxLength": 16
            }
          }
        }
      }
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "schema": {
        "type": "object"
      }
    },
    "202": {
      "contentType": "application/json",
      "schema": {
        "title": "QR Payment Request Accepted",
        "required": [
          "message",
          "code"
        ],
        "type": "object",
        "properties": {
          "code": {
            "title": "Code",
            "type": "integer"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        }
      }
    },
    "400": {
      "contentType": "application/json",
      "schema": {
