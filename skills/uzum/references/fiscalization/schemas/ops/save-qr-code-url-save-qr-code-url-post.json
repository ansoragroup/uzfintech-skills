        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    },
    "403": {
      "contentType": "application/json",
      "schema": {
        "title": "AuthErrorResponse",
        "type": "object",
        "properties": {
          "message": {
            "title": "Operation Id",
            "type": "string",
            "format": "string"
          }
        }
      }
    },
    "422": {
      "contentType": "application/json",
      "schema": {
        "title": "HTTPValidationError",
        "type": "object",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "array",
            "items": {
              "title": "ValidationError",
              "required": [
                "loc",
                "msg",
                "type"
              ],
              "type": "object",
              "properties": {
                "loc": {
                  "title": "Location",
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer"
                      }
                    ]
                  }
                },
                "msg": {
                  "title": "Message",
                  "type": "string"
                },
                "type": {
                  "title": "Error Type",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "500": {
      "contentType": "application/json",
      "schema": {
        "title": "Internal Server Error",
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
