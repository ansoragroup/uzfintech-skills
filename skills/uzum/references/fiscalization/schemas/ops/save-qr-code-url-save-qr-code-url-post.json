  "kind": "path",
  "method": "POST",
  "path": "/v2/qr_payment",
  "operationId": "save_qr_code_url_save_qr_code_url_post",
  "summary": "/v2/qr_payment",
  "tags": [
    "Передача чека  оплаты по QR-коду в налоговую"
  ],
  "parameters": [
