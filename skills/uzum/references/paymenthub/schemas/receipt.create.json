                  "url": {
                    "type": "string"
                  },
                  "terminal_id": {
                    "type": "string"
                  },
                  "fiscal_sign": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "receipt"
