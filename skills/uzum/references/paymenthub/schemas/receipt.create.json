                      "enum": [
                        "STRING",
                        "NUMBER"
                      ]
                    },
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "transaction_details": {
                "type": "object",
                "properties": {
