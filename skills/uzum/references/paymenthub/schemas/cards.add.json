          },
          "sms": {
            "type": "object",
            "properties": {
              "hash": {
                "type": "string"
              },
              "template": {
                "type": "integer"
              }
            },
            "required": [
              "hash",
              "template"
            ]
          },
          "requester_phone": {
            "type": "string"
          },
          "merchant_id": {
            "type": "integer"
          }
        },
        "required": [
          "number",
          "expire",
          "sms",
          "merchant_id"
        ]
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "id from the first cards.add (resend)"
          },
          "sms": {
            "type": "object",
            "properties": {
              "hash": {
                "type": "string"
              }
            },
            "required": [
              "hash"
            ]
          }
        },
        "required": [
          "id",
          "sms"
        ]
      }
    ]
  },
  "result": {
    "type": "object",
