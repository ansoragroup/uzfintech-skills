        },
        "required": [
          "pan",
          "expiry"
        ]
      },
      "amount": {
        "type": "integer",
        "description": "tiyin (1 UZS = 100 tiyin)",
        "minimum": 1
      },
      "store_id": {
        "type": [
          "integer",
          "string"
        ],
        "description": "cashbox id (int) or cashbox uuid (string)"
      },
      "invoice_id": {
        "type": "string",
        "description": "your order id, max 255 chars",
        "maxLength": 255
      },
      "callback_url": {
        "type": "string",
        "description": "success callback target"
      },
      "device_details": {
        "type": "object",
        "properties": {
          "ip": {
            "type": "string",
            "description": "payer device IP"
          },
          "user_agent": {
            "type": "string"
          }
        },
        "required": [
          "ip",
          "user_agent"
        ]
      },
      "ofd": {
        "$ref": "../../common/schemas/ofd.json"
      }
