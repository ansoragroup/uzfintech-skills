{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/statements-and-accounts/document-list",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; the date format is not stated (the sample uses yyyy-MM-dd, other dates are dd.MM.yyyy)"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile.svc/GetDoc1C",
  "summary": "Account statement for one date: documents, turnovers, balances and whether the day is final",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "session value (sid) from APILogin"
        },
        "branch": {
          "type": "string",
          "description": "MFO of the organization"
        },
        "account": {
          "type": "string",
          "description": "20-digit account number",
          "pattern": "^\\d{20}$"
        },
        "date": {
          "type": "string",
          "description": "statement date; today when empty; format not stated"
        },
        "from_time": {
          "type": "string",
          "description": "period start time"
        },
        "to_time": {
          "type": "string",
          "description": "period end time"
        }
      },
      "required": [
        "sid",
        "branch",
        "account"
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "content": {
                "type": "array",
                "description": "documents",
                "items": {
                  "type": "object",
                  "properties": {
                    "time": {
                      "type": "string",
                      "description": "operation time"
                    },
                    "input_date": {
                      "type": "string",
                      "description": "posting date dd.MM.yyyy"
                    },
                    "input_time": {
                      "type": "string",
                      "description": "posting time HH:mm:ss"
                    },
                    "client_id": {
                      "type": "integer",
                      "description": "client organization id (long)"
                    },
                    "num": {
                      "type": "string",
                      "description": "document number"
                    },
                    "branch": {
                      "type": "string",
                      "description": "MFO"
                    },
                    "general_id": {
                      "type": "string",
                      "description": "common document id"
                    },
                    "b2_id": {
                      "type": "string",
                      "description": "document id in the core system B2, unique across the bank"
                    },
                    "uniq": {
                      "type": "string",
                      "description": "uniq set by the client when the order was created"
                    },
                    "ddate": {
                      "type": "string",
                      "description": "document date"
                    },
                    "vdate": {
                      "type": "string",
                      "description": "value date"
                    },
                    "stime": {
                      "type": "string",
                      "description": "document creation time"
                    },
                    "mfo_dt": {
                      "type": "string"
                    },
                    "acc_dt": {
                      "type": "string"
                    },
                    "name_dt": {
                      "type": "string"
                    },
                    "inn_dt": {
                      "type": "string"
                    },
                    "mfo_ct": {
                      "type": "string"
                    },
                    "acc_ct": {
                      "type": "string"
                    },
                    "name_ct": {
                      "type": "string"
                    },
                    "inn_ct": {
                      "type": "string"
                    },
                    "purpose": {
                      "type": "string",
                      "description": "payment details text"
                    },
                    "purp_code": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "payment purpose code"
                    },
                    "amount": {
                      "type": "integer",
                      "description": "operation amount (long; unit not stated on this field)"
                    },
                    "dtype": {
                      "type": "string",
                      "description": "document type (21, 98, 99 and others)"
                    },
                    "state": {
                      "type": "integer",
                      "description": "document status 0-9 after the GetDoc1C mapping"
                    },
                    "dir": {
                      "type": "integer",
                      "description": "1 incoming, 2 outgoing",
                      "enum": [
                        1,
                        2
                      ]
                    },
                    "err": {
                      "type": "string",
                      "description": "document error code"
                    },
                    "err_msg": {
                      "type": "string",
                      "description": "error message"
                    },
                    "anor": {
                      "type": "integer",
                      "description": "0 SEP (9:00-17:00 on open-balance days), 1 Anor (24/7)",
                      "enum": [
                        0,
                        1
                      ]
                    }
                  },
                  "required": [
                    "time",
                    "client_id",
                    "num",
                    "branch",
                    "general_id",
                    "b2_id",
                    "uniq",
                    "ddate",
                    "vdate",
                    "stime",
                    "mfo_dt",
                    "acc_dt",
                    "name_dt",
                    "inn_dt",
                    "mfo_ct",
                    "acc_ct",
                    "name_ct",
                    "inn_ct",
                    "purpose",
                    "amount",
                    "dtype",
                    "state",
                    "dir",
                    "err",
                    "err_msg",
                    "anor"
                  ]
                }
              },
              "total_debit": {
                "type": "integer",
                "description": "debit total, described as in tiyin (long)"
              },
              "total_credit": {
                "type": "integer",
                "description": "credit total (long)"
              },
              "saldo_in": {
                "type": "integer",
                "description": "opening balance (long)"
              },
              "saldo_out": {
                "type": "integer",
                "description": "closing balance (long)"
              },
              "fin": {
                "type": "integer",
                "description": "0 the operating day is not closed and more credits may come; 1 final",
                "enum": [
                  0,
                  1
                ]
              },
              "oper_day": {
                "type": "string",
                "description": "operating day dd.MM.yyyy"
              }
            },
            "required": [
              "content",
              "total_debit",
              "total_credit",
              "saldo_in",
              "saldo_out",
              "fin",
              "oper_day"
            ]
          }
        },
        "required": [
          "id",
          "result"
        ]
      }
    }
  }
}
