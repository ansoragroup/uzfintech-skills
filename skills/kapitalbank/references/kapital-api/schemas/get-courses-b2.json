{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/directories/currency-rates",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile.svc/GetCoursesB2",
  "summary": "Current exchange rates for a branch; no authorization needed",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "tobo": {
          "type": "string",
          "description": "branch code (TOBO)"
        }
      }
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "filial": {
                "type": "string",
                "description": "branch code"
              },
              "date": {
                "type": "string",
                "description": "rate date dd.MM.yyyy"
              },
              "time": {
                "type": "string",
                "description": "update time HH:mm:ss"
              },
              "courses": {
                "type": "array",
                "description": "rates",
                "items": {
                  "type": "object",
                  "properties": {
                    "order": {
                      "type": "string",
                      "description": "position"
                    },
                    "flag_url": {
                      "type": "string",
                      "description": "flag image URL"
                    },
                    "kod": {
                      "type": "string",
                      "description": "letter currency code (ISO 4217)"
                    },
                    "char_kod": {
                      "type": "string",
                      "description": "numeric currency code"
                    },
                    "name": {
                      "type": "string",
                      "description": "currency name"
                    },
                    "course_cb": {
                      "type": "string",
                      "description": "CBU rate"
                    },
                    "change_cb": {
                      "type": "string",
                      "description": "CBU rate change"
                    },
                    "course_buy": {
                      "type": "string",
                      "description": "bank buy rate"
                    },
                    "change_buy": {
                      "type": "string",
                      "description": "buy rate change"
                    },
                    "course_sell": {
                      "type": "string",
                      "description": "bank sell rate"
                    },
                    "change_sell": {
                      "type": "string",
                      "description": "sell rate change"
                    }
                  },
                  "required": [
                    "order",
                    "flag_url",
                    "kod",
                    "char_kod",
                    "name",
                    "course_cb",
                    "change_cb",
                    "course_buy",
                    "change_buy",
                    "course_sell",
                    "change_sell"
                  ]
                }
              }
            },
            "required": [
              "filial",
              "date",
              "time",
              "courses"
            ]
          }
        },
        "required": [
          "result"
        ]
      }
    }
  }
}
