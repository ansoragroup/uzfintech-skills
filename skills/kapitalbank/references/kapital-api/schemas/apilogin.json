{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/authorization/user-authorization",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; no body fields are documented, so there is no requestBody; the page's only sample is an IP-restriction error"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "Mobile.svc/APILogin",
  "summary": "Log in with internet-banking credentials and get the session value (sid) and the organizations",
  "parameters": [
    {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "description": "Basic base64(login:password); the internet-banking login carries the IB# prefix. Marked not required in the table; with IP restriction every request carries it"
    },
    {
      "name": "X-Original-Forwarded-For",
      "in": "header",
      "required": false,
      "description": "client IP address"
    }
  ],
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "description": "LoginAPIResult; null on error",
            "properties": {
              "login": {
                "type": "string",
                "description": "login of the authorized user"
              },
              "sid": {
                "type": "string",
                "description": "session value"
              },
              "clients": {
                "type": "array",
                "description": "organizations available to the user",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "integer"
                      ],
                      "description": "organization id; typed string here but passed as integer client_id to SendPaymentIBK and CheckPayments2"
                    },
                    "branch": {
                      "type": "string",
                      "description": "MFO of the organization"
                    },
                    "code": {
                      "type": "string",
                      "description": "unique organization code"
                    },
                    "name": {
                      "type": "string",
                      "description": "organization name"
                    },
                    "oper_day": {
                      "type": "string",
                      "description": "operating day of the branch"
                    },
                    "doc_num": {
                      "type": "string",
                      "description": "number of the last payment order sent"
                    },
                    "inn": {
                      "type": "string",
                      "description": "INN"
                    },
                    "pinfl": {
                      "type": "string",
                      "description": "PINFL of an individual"
                    },
                    "cert_sn": {
                      "type": "string",
                      "description": "certificate serial number"
                    },
                    "dir_name": {
                      "type": "string",
                      "description": "director's full name"
                    },
                    "buh_name": {
                      "type": "string",
                      "description": "accountant's full name"
                    },
                    "address": {
                      "type": "string",
                      "description": "legal address"
                    },
                    "phone": {
                      "type": "string",
                      "description": "phone number"
                    },
                    "fax": {
                      "type": "string",
                      "description": "fax"
                    },
                    "accounts": {
                      "type": "array",
                      "description": "accounts of the organization",
                      "items": {
                        "$ref": "#/$defs/Account"
                      }
                    },
                    "zp_accs": {
                      "type": "array",
                      "description": "salary transit accounts",
                      "items": {
                        "type": "object",
                        "properties": {
                          "branch": {
                            "type": "string",
                            "description": "MFO"
                          },
                          "account": {
                            "type": "string",
                            "description": "account number"
                          }
                        },
                        "required": [
                          "branch",
                          "account"
                        ]
                      }
                    },
                    "zp_humo_accs": {
                      "type": "array",
                      "description": "salary transit accounts for HUMO",
                      "items": {
                        "type": "object",
                        "properties": {
                          "branch": {
                            "type": "string",
                            "description": "MFO"
                          },
                          "account": {
                            "type": "string",
                            "description": "account number"
                          }
                        },
                        "required": [
                          "branch",
                          "account"
                        ]
                      }
                    },
                    "curpur_accs": {
                      "type": "array",
                      "description": "targeted current accounts",
                      "items": {
                        "type": "object",
                        "properties": {
                          "aid": {
                            "type": "string"
                          },
                          "branch": {
                            "type": "string"
                          },
                          "account": {
                            "type": "string"
                          },
                          "val": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "aid",
                          "branch",
                          "account",
                          "val"
                        ]
                      }
                    },
                    "pc_accs": {
                      "type": "array",
                      "description": "card accounts",
                      "items": {
                        "type": "object",
                        "properties": {
                          "aid": {
                            "type": "string"
                          },
                          "branch": {
                            "type": "string"
                          },
                          "account": {
                            "type": "string"
                          },
                          "val": {
                            "type": "string"
                          },
                          "kod_pc": {
                            "type": "string",
                            "description": "payment card code"
                          }
                        },
                        "required": [
                          "aid",
                          "branch",
                          "account",
                          "val",
                          "kod_pc"
                        ]
                      }
                    },
                    "qr_accs": {
                      "type": "array",
                      "description": "QR accounts",
                      "items": {
                        "type": "object",
                        "properties": {
                          "branch": {
                            "type": "string"
                          },
                          "account": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "s_out": {
                            "type": "integer",
                            "description": "closing balance (long)"
                          }
                        },
                        "required": [
                          "branch",
                          "account",
                          "name",
                          "s_out"
                        ]
                      }
                    },
                    "modules": {
                      "type": "array",
                      "description": "available modules and actions",
                      "items": {
                        "type": "object",
                        "properties": {
                          "module": {
                            "type": "integer"
                          },
                          "actions": {
                            "type": "array",
                            "items": {
                              "type": "integer"
                            }
                          }
                        },
                        "required": [
                          "module",
                          "actions"
                        ]
                      }
                    },
                    "payment_scheme": {
                      "type": "string",
                      "description": "payment scheme, 0 by default"
                    },
                    "k2_count": {
                      "type": "integer",
                      "description": "number of K2 documents"
                    },
                    "cards_count": {
                      "type": "integer",
                      "description": "number of cards"
                    },
                    "canpay_sum": {
                      "type": "boolean",
                      "description": "can pay by amount"
                    },
                    "tobo_id": {
                      "type": "integer",
                      "description": "territorial office id"
                    },
                    "zp_upi_accs": {
                      "type": "array",
                      "description": "salary transit accounts for UPI",
                      "items": {
                        "type": "object",
                        "properties": {
                          "branch": {
                            "type": "string",
                            "description": "MFO"
                          },
                          "account": {
                            "type": "string",
                            "description": "account number"
                          }
                        },
                        "required": [
                          "branch",
                          "account"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "branch",
                    "code",
                    "name",
                    "oper_day",
                    "inn",
                    "phone",
                    "accounts",
                    "payment_scheme",
                    "k2_count",
                    "cards_count",
                    "canpay_sum"
                  ]
                }
              }
            },
            "required": [
              "login",
              "sid",
              "clients"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    }
  },
  "$defs": {
    "Account": {
      "type": "object",
      "properties": {
        "aid": {
          "type": "integer",
          "description": "account id (long)"
        },
        "branch": {
          "type": "string",
          "description": "MFO"
        },
        "account": {
          "type": "string",
          "description": "20-digit account number"
        },
        "name": {
          "type": "string",
          "description": "account name"
        },
        "val": {
          "type": "string",
          "description": "currency code; described as UZS, USD, EUR, but samples also print \"000\""
        },
        "o_date": {
          "type": "string",
          "description": "opening date"
        },
        "l_date": {
          "type": "string",
          "description": "date of the last transaction"
        },
        "s_in": {
          "type": "integer",
          "description": "opening balance (long; unit not stated)"
        },
        "s_out": {
          "type": "integer",
          "description": "closing or current balance (long; unit not stated)"
        },
        "dt": {
          "type": "integer",
          "description": "debit turnover (long; unit not stated)"
        },
        "ct": {
          "type": "integer",
          "description": "credit turnover (long; unit not stated)"
        },
        "canpay": {
          "type": "integer",
          "description": "payments allowed: 0 no, 1 yes",
          "enum": [
            0,
            1
          ]
        },
        "state": {
          "type": "integer",
          "description": "account state (1 open, 0 closed, other values not listed)"
        },
        "notif_in": {
          "type": "integer",
          "description": "notify on credit, 0/1"
        },
        "notif_out": {
          "type": "integer",
          "description": "notify on debit, 0/1"
        },
        "special": {
          "type": "array",
          "description": "special accounts",
          "items": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "description": "MFO"
              },
              "acc": {
                "type": "string",
                "description": "account number"
              },
              "id_special": {
                "type": "integer",
                "description": "special account id"
              },
              "prim": {
                "type": "string",
                "description": "note"
              }
            },
            "required": [
              "branch",
              "acc",
              "id_special",
              "prim"
            ]
          }
        },
        "sign1": {
          "type": "integer",
          "description": "not described"
        },
        "sign2": {
          "type": "integer",
          "description": "not described"
        },
        "sign3": {
          "type": "integer",
          "description": "not described"
        },
        "stateName": {
          "type": "string",
          "description": "account state name"
        }
      },
      "required": [
        "aid",
        "branch",
        "account",
        "name",
        "val",
        "o_date",
        "s_in",
        "s_out",
        "dt",
        "ct",
        "canpay",
        "state",
        "sign1",
        "sign2",
        "sign3",
        "stateName"
      ]
    }
  }
}
