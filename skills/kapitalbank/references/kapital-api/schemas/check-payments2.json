{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/payment-orders/payment-status",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; anyOf and maxItems from the algorithm text (at least one list, at most 100 values)"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile.svc/CheckPayments2",
  "summary": "Get the status of payment documents by uniq or general_id (the recommended second version)",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "session value (sid) from APILogin"
        },
        "client_id": {
          "type": "integer",
          "description": "organization id"
        },
        "uniqs": {
          "type": "array",
          "description": "uniq values to check",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        },
        "general_ids": {
          "type": "array",
          "description": "general_id values to check",
          "items": {
            "type": "string"
          },
          "maxItems": 100
        }
      },
      "required": [
        "sid",
        "client_id"
      ],
      "anyOf": [
        {
          "required": [
            "uniqs"
          ]
        },
        {
          "required": [
            "general_ids"
          ]
        }
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "array",
              "null"
            ],
            "description": "one entry per document",
            "items": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string",
                  "description": "MFO where the document was created when state = 54, else an empty string"
                },
                "err": {
                  "type": "integer",
                  "description": "payment error code"
                },
                "err_msg": {
                  "type": "string",
                  "description": "payment error message"
                },
                "general_id": {
                  "type": "integer",
                  "description": "unique document number in branch when state = 54, else 0 (long)"
                },
                "state": {
                  "type": "integer",
                  "description": "external status: 55 draft; 54, 53 or 56 from the core system; 53 deleted"
                },
                "state_name": {
                  "type": "string",
                  "description": "status name"
                },
                "uniq": {
                  "type": "string",
                  "description": "document uniq"
                }
              },
              "required": [
                "branch",
                "err",
                "err_msg",
                "general_id",
                "state",
                "state_name",
                "uniq"
              ]
            }
          }
        },
        "required": [
          "id",
          "result"
        ]
      }
    }
  }
}
