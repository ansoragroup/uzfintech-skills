{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/clients-and-accounts/client-account-information",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; the path is kept as published (/Mobile/svc/, every other method uses Mobile.svc)"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile/svc/GetAccounts",
  "summary": "Account details by account number (one-element result array)",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "session value (sid) from APILogin; optional because login and password may come in Authorization: Basic instead"
        },
        "branch": {
          "type": "string",
          "description": "branch MFO, 5 characters",
          "pattern": "^\\d{5}$"
        },
        "account": {
          "type": "string",
          "description": "account number, 20 digits only",
          "pattern": "^\\d{20}$"
        }
      },
      "required": [
        "branch",
        "account"
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "array",
              "null"
            ],
            "description": "one account",
            "items": {
              "$ref": "#/$defs/Account"
            }
          }
        },
        "required": [
          "id",
          "result"
        ]
      }
    }
  },
  "$defs": {
    "Account": {
      "type": "object",
      "properties": {
        "aid": {
          "type": "integer",
          "description": "account id (long)"
        },
        "branch": {
          "type": "string",
          "description": "MFO"
        },
        "account": {
          "type": "string",
          "description": "20-digit account number"
        },
        "name": {
          "type": "string",
          "description": "account name"
        },
        "val": {
          "type": "string",
          "description": "currency code; described as UZS, USD, EUR, but samples also print \"000\""
        },
        "o_date": {
          "type": "string",
          "description": "opening date"
        },
        "l_date": {
          "type": "string",
          "description": "date of the last transaction"
        },
        "s_in": {
          "type": "integer",
          "description": "opening balance (long; unit not stated)"
        },
        "s_out": {
          "type": "integer",
          "description": "closing or current balance (long; unit not stated)"
        },
        "dt": {
          "type": "integer",
          "description": "debit turnover (long; unit not stated)"
        },
        "ct": {
          "type": "integer",
          "description": "credit turnover (long; unit not stated)"
        },
        "canpay": {
          "type": "integer",
          "description": "payments allowed: 0 no, 1 yes",
          "enum": [
            0,
            1
          ]
        },
        "state": {
          "type": "integer",
          "description": "account state (1 open, 0 closed, other values not listed)"
        },
        "notif_in": {
          "type": "integer",
          "description": "notify on credit, 0/1"
        },
        "notif_out": {
          "type": "integer",
          "description": "notify on debit, 0/1"
        },
        "special": {
          "type": "array",
          "description": "special accounts",
          "items": {
            "type": "object",
            "properties": {
              "branch": {
                "type": "string",
                "description": "MFO"
              },
              "acc": {
                "type": "string",
                "description": "account number"
              },
              "id_special": {
                "type": "integer",
                "description": "special account id"
              },
              "prim": {
                "type": "string",
                "description": "note"
              }
            },
            "required": [
              "branch",
              "acc",
              "id_special",
              "prim"
            ]
          }
        },
        "sign1": {
          "type": "integer",
          "description": "not described"
        },
        "sign2": {
          "type": "integer",
          "description": "not described"
        },
        "sign3": {
          "type": "integer",
          "description": "not described"
        },
        "stateName": {
          "type": "string",
          "description": "account state name"
        }
      },
      "required": [
        "aid",
        "branch",
        "account",
        "name",
        "val",
        "o_date",
        "l_date",
        "s_in",
        "s_out",
        "dt",
        "ct",
        "canpay",
        "notif_in",
        "notif_out",
        "state",
        "sign1",
        "sign2",
        "sign3",
        "stateName"
      ]
    }
  }
}
