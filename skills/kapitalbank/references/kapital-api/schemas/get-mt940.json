{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/statements-and-accounts/mt940-statement",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; result is typed string (MT940 text) although the table also lists paymentId ... transactionType sub-fields; the date pattern follows the stated dd.MM.yyyy"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile.svc/GetMT940",
  "summary": "Account statement for one date as MT940 text",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "session value (sid) from APILogin; optional because login and password may come in Authorization: Basic instead"
        },
        "branch": {
          "type": "string",
          "description": "branch MFO"
        },
        "account": {
          "type": "string",
          "description": "account number"
        },
        "date": {
          "type": "string",
          "description": "statement date dd.MM.yyyy",
          "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$"
        }
      },
      "required": [
        "branch",
        "account",
        "date"
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "string",
              "null"
            ],
            "description": "MT940 statement text"
          }
        },
        "required": [
          "id",
          "result"
        ]
      }
    }
  }
}
