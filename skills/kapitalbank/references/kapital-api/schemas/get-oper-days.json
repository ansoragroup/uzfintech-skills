{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/clients-and-accounts/oper-day-information",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile.svc/GetOperDays",
  "summary": "Operating day of a branch",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "session value (sid) from APILogin; optional because login and password may come in Authorization: Basic instead"
        },
        "branch": {
          "type": "string",
          "description": "branch MFO, 5 characters",
          "pattern": "^\\d{5}$"
        }
      },
      "required": [
        "branch"
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "array",
              "null"
            ],
            "description": "one element",
            "items": {
              "type": "object",
              "properties": {
                "branch": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "description": "operating day name"
                },
                "date": {
                  "type": "string",
                  "description": "operating day date"
                },
                "state": {
                  "type": "string",
                  "description": "operating day state, for example OPEN"
                },
                "desc": {
                  "type": "string",
                  "description": "state description"
                }
              },
              "required": [
                "branch",
                "name",
                "date",
                "state",
                "desc"
              ]
            }
          }
        },
        "required": [
          "id",
          "result"
        ]
      }
    }
  }
}
