  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "/Mobile.svc/GetBudjetAcc",
  "summary": "Check a budget recipient account (and INN) against the CBU directories and get the payee requisites",
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "ls": {
          "type": "string",
          "description": "personal (budget) account number"
        },
        "inn": {
          "type": "string",
          "description": "organization INN"
        }
      },
      "required": [
        "ls"
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "null on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            }
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "description": "payee requisites",
            "properties": {
              "mfo": {
                "type": "string",
                "description": "MFO"
              },
              "acc": {
                "type": "string",
                "description": "account"
              },
              "name": {
                "type": "string",
                "description": "name"
              },
              "inn": {
                "type": "string",
                "description": "INN"
              },
              "sid": {
                "type": "string",
                "description": "session value (empty in the sample)"
              }
            },
            "required": [
              "mfo",
              "acc",
              "name",
              "inn",
              "sid"
            ]
          }
        }
      }
    }
  }
}
