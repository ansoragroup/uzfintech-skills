{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/invoices/invoice-status",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; result is typed as one object although the request takes an array, so both shapes are accepted; no sample is published"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "api/invoices/check-statuses",
  "summary": "Get the status of invoices by an array of ids",
  "parameters": [
    {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "description": "takes priority over sid; its scheme is not described on this page (APILogin uses Basic)"
    }
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "session value; required when no Authorization header is sent"
        },
        "code": {
          "type": "string",
          "description": "client НИББД code, exactly 8 characters",
          "minLength": 8,
          "maxLength": 8
        },
        "branch": {
          "type": "string",
          "description": "MFO, exactly 5 characters",
          "minLength": 5,
          "maxLength": 5
        },
        "invoiceId": {
          "type": "array",
          "description": "invoice ids, at most 100",
          "items": {
            "type": "integer"
          },
          "maxItems": 100
        }
      },
      "required": [
        "code",
        "branch",
        "invoiceId"
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "present when the call failed (code and message are then required); null or absent on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "description": "present on success",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "invoiceId": {
                    "type": "integer",
                    "description": "invoice id (long)"
                  },
                  "status": {
                    "type": "integer",
                    "description": "invoice status; values not published"
                  }
                },
                "required": [
                  "invoiceId",
                  "status"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "invoiceId": {
                      "type": "integer",
                      "description": "invoice id (long)"
                    },
                    "status": {
                      "type": "integer",
                      "description": "invoice status; values not published"
                    }
                  },
                  "required": [
                    "invoiceId",
                    "status"
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
