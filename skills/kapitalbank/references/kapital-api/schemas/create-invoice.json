{
  "x-uzfintech-source": {
    "source_url": "https://b2b-api-docs.kapitalbank.uz/invoices/create-invoice",
    "fetched": "2026-11-04",
    "note": "transcribed from the field table on the page; descriptions in our own words; no request or response sample is published; validations from the table's Validation column"
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "kind": "path",
  "method": "POST",
  "path": "api/invoices",
  "summary": "Validate and prepare an invoice for payment (счет на оплату), checking the recipient and the purpose",
  "parameters": [
    {
      "name": "Authorization",
      "in": "header",
      "required": false,
      "description": "takes priority over sid; its scheme is not described on this page (APILogin uses Basic)"
    }
  ],
  "requestBody": {
    "required": true,
    "contentType": "application/json",
    "schema": {
      "type": "object",
      "properties": {
        "sid": {
          "type": "string",
          "description": "user token; required when no Authorization header is sent (the header wins)"
        },
        "code": {
          "type": "string",
          "description": "client НИББД code, exactly 8 characters",
          "minLength": 8,
          "maxLength": 8
        },
        "branch": {
          "type": "string",
          "description": "MFO, exactly 5 characters",
          "minLength": 5,
          "maxLength": 5
        },
        "senderAccountNumber": {
          "type": "string",
          "description": "sender account, exactly 20 characters",
          "minLength": 20,
          "maxLength": 20
        },
        "receiverBusinessCode": {
          "type": "string",
          "description": "recipient НИББД code; must differ from code"
        },
        "receiverBusinessName": {
          "type": "string",
          "description": "recipient name"
        },
        "receiverTinOrPinfl": {
          "type": "string",
          "description": "recipient INN (9) or PINFL (14)",
          "pattern": "^(.{9}|.{14})$"
        },
        "amount": {
          "type": "integer",
          "description": "amount (Long; must be greater than 5000000; unit not stated)",
          "exclusiveMinimum": 5000000
        },
        "purposeText": {
          "type": "string",
          "description": "purpose text (labelled \"Наименование цели кредита\"); filled from the directory when absent",
          "minLength": 20,
          "maxLength": 450
        },
        "purposeCode": {
          "type": "string",
          "description": "purpose code (labelled \"Код цели кредита\"); checked against a directory, an unknown code is an error"
        },
        "dueDate": {
          "type": "string",
          "description": "expected payment date-time; must be later than now",
          "format": "date-time"
        }
      },
      "required": [
        "code",
        "branch",
        "senderAccountNumber",
        "amount",
        "purposeCode",
        "dueDate"
      ],
      "anyOf": [
        {
          "required": [
            "receiverBusinessCode"
          ]
        },
        {
          "required": [
            "receiverTinOrPinfl"
          ]
        }
      ]
    }
  },
  "responses": {
    "200": {
      "contentType": "application/json",
      "description": "every documented answer is HTTP 200 with the {error, id, result} envelope; check error first",
      "schema": {
        "type": "object",
        "properties": {
          "error": {
            "type": [
              "object",
              "null"
            ],
            "description": "present when the call failed (code and message are then required); null or absent on success",
            "properties": {
              "code": {
                "type": "integer",
                "description": "error code"
              },
              "message": {
                "type": "string",
                "description": "error text"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "id": {
            "type": "integer",
            "description": "response id generated by the bank (long)"
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "description": "present on success",
            "properties": {
              "invoice_id": {
                "type": "integer",
                "description": "invoice id (long)"
              }
            },
            "required": [
              "invoice_id"
            ]
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
